# LeadScout needs no secrets. All variables are optional.

# --- App ---
# Public URL of the deployed site; used in the User-Agent sent to OpenStreetMap
# services (their usage policy asks apps to identify themselves).
APP_URL=http://localhost:3000

# --- Limits ---
# Lead searches allowed per visitor IP per minute (protects the free OSM servers).
SEARCHES_PER_MINUTE=8

# --- Data sources ---
# Comma-separated Overpass API mirrors, tried in order. Leave empty for the
# built-in list (overpass-api.de, maps.mail.ru, overpass.kumi.systems).
OVERPASS_URLS=
